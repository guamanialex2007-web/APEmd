def completarMatrices(n: str) -> list:
    """Solicita al usuario los enteros para poblar una matriz bidimensional de 2x3."""
    return [[int(input(f"{n}[{i}][{j}]: ")) for j in range(3)] for i in range(2)]

def sumaMatriz(A: list, B: list) -> list:
    """Retorna una nueva matriz de 2x3 con la suma aritmética de sus componentes."""
    return [[A[i][j] + B[i][j] for j in range(3)] for i in range(2)]

def restaMatriz(A: list, B: list) -> list:
    """Retorna una nueva matriz de 2x3 con el resultado de la sustracción (A - B)."""
    return [[A[i][j] - B[i][j] for j in range(3)] for i in range(2)]

def multiplicacionMatriz(A: list, B: list) -> list:
    """Retorna una nueva matriz de 2x3 tras el producto directo de sus valores análogos."""
    return [[A[i][j] * B[i][j] for j in range(3)] for i in range(2)]

def mostrarResultado(t: str, M: list):
    """Genera la visualización en consola aplicando sangría y enmarcado estético de filas."""
    print(f"\n{t}:")
    for f in M:
        print("[", " ".join(f"{x:4}" for x in f), "]")

def main():
    # Flujo controlador principal del sistema
    A = completarMatrices("A")
    B = completarMatrices("B")
    
    mostrarResultado("Suma", sumaMatriz(A, B))
    mostrarResultado("Resta", restaMatriz(A, B))
    mostrarResultado("Multiplicación", multiplicacionMatriz(A, B))

if __name__ == "__main__":
    main()
